<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Unity-Restart-Tool</AssemblyName>
    <RootNamespace>UnityRestartTool</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>res\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\Application\**\*.cs" />
    <Content Include="src\EditorCompanion\Package\**\*">
      <Link>EditorCompanion\Package\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <Target Name="ArchiveAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_Timestamp>$([System.DateTime]::Now.ToString("yyMMdd-HHmmss"))</_Timestamp>
      <_PackageType Condition="'$(SelfContained)' == 'true'">self-contained</_PackageType>
      <_PackageType Condition="'$(_PackageType)' == ''">portable</_PackageType>
      <_Platform>$([System.String]::Copy('$(RuntimeIdentifier)').Split('-')[0])</_Platform>
      <_ZipName>$(AssemblyName)-$(_Platform)-$(_PackageType)-$(_Timestamp).zip</_ZipName>
      <_ArchiveDir>$(MSBuildProjectDirectory)\bin\Release-Archives</_ArchiveDir>
    </PropertyGroup>
    <MakeDir Directories="$(_ArchiveDir)" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_ArchiveDir)\$(_ZipName)" Overwrite="true" />
    <Message Importance="high" Text="Archived: $(_ArchiveDir)\$(_ZipName)" />
  </Target>

</Project>
